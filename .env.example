# Optional. When both are set, `oah serve` uses open-ai-gateway instead of MockModel.
OAH_GATEWAY__URL=http://127.0.0.1:8080
OAH_GATEWAY__KEY=oag_live_replace_me

# Optional overrides (same convention as the gateway: OAH_<SECTION>__<FIELD>).
# OAH_SERVER__BIND=0.0.0.0:43147
# OAH_STORE__PATH=.oah/dev.db
